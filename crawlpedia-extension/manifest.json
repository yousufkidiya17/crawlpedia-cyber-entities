{
  "manifest_version": 3,
  "name": "Crawlpedia Cyber Entities",
  "version": "5.0.0",
  "description": "Spawn AI-powered cybernetic wireframe crawlers (Spiders, Centipedes, Rovers) that explore, scan, and glitch words across any webpage.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crawlpedia Entity Controller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "commands": {
    "toggle-crawler": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Toggle Crawlpedia Entity on Active Webpage"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}